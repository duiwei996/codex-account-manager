; Project-owned entry point. The embedded installer is generated by stock Tauri.
Unicode true
RequestExecutionLevel user
SilentInstall silent
SetCompressor /SOLID lzma
!include FileFunc.nsh
!include LogicLib.nsh
!include WordFunc.nsh
!include StrFunc.nsh
${StrLoc}
!define /ifndef PRODUCT_NAME "Codex Account Manager"
!define /ifndef PUBLISHER "duiwei996"
!define /ifndef MAIN_BINARY "codex-account-manager"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define LOCATION_KEY "Software\${PUBLISHER}\${PRODUCT_NAME}"
Name "${PRODUCT_NAME}"
InstallDir "placeholder\${PRODUCT_NAME}"
OutFile "${OUTPUT_FILE}"
VIProductVersion "${APP_VERSION}.0"
VIAddVersionKey /LANG=1033 "ProductName" "${PRODUCT_NAME}"
VIAddVersionKey /LANG=1033 "FileVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=1033 "FileDescription" "${PRODUCT_NAME} setup"
VIAddVersionKey /LANG=1033 "LegalCopyright" "${PUBLISHER}"
Var InstallDirectory
Var InstalledVersion
Var Arguments

Function .onInit
  SetRegView 64
  ${GetParameters} $Arguments
  ReadRegStr $InstallDirectory HKCU "${LOCATION_KEY}" ""
  ReadRegStr $0 HKCU "${UNINSTALL_KEY}" "Publisher"
  ${If} $InstallDirectory != ""
  ${AndIf} $0 == "${PUBLISHER}"
    ReadRegStr $0 HKCU "${UNINSTALL_KEY}" "UninstallString"
    ${If} $0 != '$\"$InstallDirectory\uninstall.exe$\"'
      Goto invalid_installation
    ${EndIf}
    IfFileExists "$InstallDirectory\${MAIN_BINARY}.exe" 0 invalid_installation
    IfFileExists "$InstallDirectory\uninstall.exe" 0 invalid_installation
    ReadRegStr $InstalledVersion HKCU "${UNINSTALL_KEY}" "DisplayVersion"
    ${If} $InstalledVersion != ""
      ${VersionCompare} "${APP_VERSION}" $InstalledVersion $0
      ${If} $0 == 2
        ; No old installer or uninstaller has run at this point.
        ClearErrors
        ${GetOptions} $Arguments "/S" $1
        ${If} ${Errors}
          MessageBox MB_ICONSTOP|MB_OK "A newer version ($InstalledVersion) is installed. / 已安装更高版本，请使用相同或更高版本的安装包。"
        ${EndIf}
        SetErrorLevel 1
        Quit
      ${EndIf}
    ${EndIf}
    ; /D is an NSIS final argument. Keep the registered directory on upgrades.
    ${StrLoc} $0 $Arguments "/D=" ">"
    ${If} $0 != ""
      StrCpy $Arguments $Arguments $0
    ${EndIf}
    ClearErrors
    ${GetOptions} $Arguments "/UPDATE" $1
    ${If} ${Errors}
      ClearErrors
      ${GetOptions} $Arguments "/S" $1
      ${If} ${Errors}
        StrCpy $Arguments "$Arguments /R"
      ${EndIf}
    ${EndIf}
    StrCpy $Arguments "$Arguments /P /UPDATE /NS /D=$InstallDirectory"
    Return
  ${EndIf}
  ; NSIS consumes /D before GetParameters; forward its parsed directory explicitly.
  ${If} $INSTDIR != "placeholder\${PRODUCT_NAME}"
    StrCpy $Arguments "$Arguments /D=$INSTDIR"
  ${EndIf}
  ; A fresh install retains the stock installer UI.
  Return
invalid_installation:
  ClearErrors
  ${GetOptions} $Arguments "/S" $1
  ${If} ${Errors}
    MessageBox MB_ICONSTOP|MB_OK "Existing installation metadata is inconsistent. / 现有安装信息不一致，请修复安装记录后重试。"
  ${EndIf}
  SetErrorLevel 2
  Quit
FunctionEnd

Section
  InitPluginsDir
  SetOutPath "$PLUGINSDIR"
  File /oname=official-setup.exe "${PAYLOAD_FILE}"
  ClearErrors
  ExecWait '$\"$PLUGINSDIR\official-setup.exe$\" $Arguments' $0
  ${If} ${Errors}
    SetErrorLevel 2
  ${Else}
    SetErrorLevel $0
  ${EndIf}
SectionEnd
